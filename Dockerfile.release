# The release image (#361): a `mix release` built in a builder stage and
# copied into a runner stage with no Mix, no compiler and no Rust. The default
# `Dockerfile` is the dev image and is not this one; ci/release_smoke.sh (the
# `release-image` job) gates this file, ci/compose_smoke.sh gates that one.
#
# Generated by `mix phx.gen.release --docker` (Phoenix 1.8.17) and then edited
# by hand. The generator's raw output is the first commit of pull request #407
# (87179c5; master holds only the squashed result), so the diff against that
# commit is what is ours. Its build-context ignore file is
# Dockerfile.release.dockerignore, which BuildKit prefers over .dockerignore
# (the dev image's) when building this file.
#
# This file is based on these images:
#
#   - https://hub.docker.com/r/hexpm/elixir/tags - for the builder image
#     E.g.: docker.io/hexpm/elixir:1.20.2-erlang-28.5.0.5-debian-bookworm-20260713-slim
#   - https://hub.docker.com/_/debian/tags?name=bookworm-20260713-slim - for the runner image
#     E.g.: docker.io/debian:bookworm-20260713-slim
#
# Find builder and runner images on Docker Hub or on Hex's Build Server (Bob).
# We recommend using Bob's Web UI to find recent tags:
#
#   - https://bob.hex.pm/docker?repo=hexpm/elixir&os=debian&sort=elixir_version,erlang_version,os_version
#
# We suggest using the same Debian version for both the builder and runner images.
#
# We suggest Debian/Ubuntu instead of Alpine to avoid production compatibility issues
# (such as DNS resolution failures, and dynamically linked NIFs/precompiled binaries).
#
# For finding packages in Debian, search on https://packages.debian.org/.

# Elixir and Erlang/OTP are the releases .tool-versions pins (1.20.2 / 28.5;
# hexpm publishes 28.5 as patch builds, and 28.5.0.5 is the newest), on the
# Debian release the dev image is on: bookworm, where the generator chose
# trixie. The dev `Dockerfile` is on the same hexpm tag. Move these with
# .tool-versions, the dev `Dockerfile` and quality.yml, never alone.
ARG ELIXIR_VERSION=1.20.2
ARG OTP_VERSION=28.5.0.5
ARG DEBIAN_VERSION=bookworm-20260713-slim

# The Rust toolchain that compiles the parsebooks NIF, pinned: a new Rust
# release must not change the NIF that is deployed, or turn the release-image
# gate red, with no change to this repository. Bump it on purpose.
ARG RUST_VERSION=1.100.0

ARG BUILDER_IMAGE="docker.io/hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}"
ARG RUNNER_IMAGE="docker.io/debian:${DEBIAN_VERSION}"

FROM ${BUILDER_IMAGE} AS builder

# install build dependencies (curl and ca-certificates are for rustup below)
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential git curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Rust, for the builder stage only: `use Rustler` in Cake.ParseBooks compiles
# the parsebooks crate (native/parsebooks) during `mix compile`. RUST_VERSION
# pins the toolchain (the dev `Dockerfile` and the CI jobs take whatever is
# stable). The runner stage needs none of it: the compiled NIF travels inside
# the release, in the cake application's priv/native.
ENV RUSTUP_HOME="/usr/local/rustup" \
    CARGO_HOME="/usr/local/cargo" \
    PATH="/usr/local/cargo/bin:${PATH}"
ARG RUST_VERSION
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
  | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}"

# prepare build dir
WORKDIR /app

# install hex + rebar
RUN mix local.hex --force \
  && mix local.rebar --force

# set build ENV
ENV MIX_ENV="prod"

# install mix dependencies
COPY mix.exs mix.lock ./
RUN mix deps.get --only $MIX_ENV
RUN mkdir config

# copy compile-time config files before we compile dependencies
# to ensure any relevant config change will trigger the dependencies
# to be re-compiled.
COPY config/config.exs config/${MIX_ENV}.exs config/
RUN mix deps.compile

RUN mix assets.setup

COPY priv priv

# Two things under priv must never reach the image: a NIF built anywhere but
# here, and the seeds, which create a login whose password is in the repo.
# (priv/reference and priv/hooks are developer files the release has no use
# for; they go too.) Dockerfile.release.dockerignore keeps all of these out of
# the build context; this line holds even for a builder that reads a different
# ignore file (flyctl's non-BuildKit path reads .dockerignore unless told
# otherwise). `mix compile` below builds the only parsebooks.so the release
# carries, and nothing in the release runs seeds. ci/release_smoke.sh plants a
# file in priv/native before building and fails if it reaches the release.
RUN rm -rf priv/native priv/repo/seeds.exs priv/reference priv/hooks

# The parsebooks crate, compiled by `mix compile` through Rustler.
COPY native native

COPY lib lib

# Compile the release
RUN mix compile

COPY assets assets

# compile assets
RUN mix assets.deploy

# Changes to config/runtime.exs don't require recompiling the code
COPY config/runtime.exs config/

COPY rel rel
RUN mix release

# start a new build stage so that the final image will only contain
# the compiled release and other runtime necessities
FROM ${RUNNER_IMAGE} AS final

RUN apt-get update \
  && apt-get install -y --no-install-recommends libstdc++6 openssl libncurses6 locales ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Set the locale
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
  && locale-gen

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

WORKDIR "/app"
RUN chown nobody /app

# set runner ENV
ENV MIX_ENV="prod"

# Only copy the final release from the build stage
COPY --from=builder --chown=nobody:root /app/_build/${MIX_ENV}/rel/cake ./

USER nobody

# If using an environment that doesn't automatically reap zombie processes, it is
# advised to add an init process such as tini via `apt-get install`
# above and adding an entrypoint. See https://github.com/krallin/tini for details
# ENTRYPOINT ["/tini", "--"]

CMD ["/app/bin/server"]
