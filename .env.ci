# CI-safe environment for the docker-compose smoke test (ci/compose_smoke.sh,
# #250). `docker compose --env-file .env.ci` interpolates these into
# docker-compose.yml + docker-compose.ci.yml; the app never reads this file.
#
# Nothing here is a secret, and nothing here may become one: the file is
# checked in.
#
# UID / GID
#   The Dockerfile's USER_ID / GROUP_ID build args. docker-compose.yml passes
#   ${UID} / ${GID}, which bash sets but never exports, so without these the
#   build fails at useradd with an empty uid. 1000 is the runner's own uid;
#   the container runs as root regardless.
# CAKE_PG*
#   The dev stack's trust-authenticated Postgres role: config/dev.exs
#   hardcodes postgres/postgres and reads PGHOST/PGDATABASE/PGPORT. The host
#   is the compose service name.
# OPENSEARCH_INITIAL_ADMIN_PASSWORD
#   Never used for auth (docker-compose.yml disables the security plugin),
#   but the image's entrypoint still demands a password that passes its
#   strength check. Strong, therefore, not secret.
# OPENAI_KEY
#   A placeholder that is not a key at all: nothing calls the provider at
#   boot, and the smoke test proves the app comes up without a real one.
#   Deliberately not shaped like a real key, so secret scanners stay quiet.
UID=1000
GID=1000
CAKE_PGUSER=postgres
CAKE_PGPASSWORD=postgres
CAKE_PGDATABASE=cake_dev
CAKE_PGHOST=db
CAKE_PGPORT=5432
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Compose-Smoke-Only-2026!
OPENAI_KEY=compose-smoke-placeholder-not-a-key
