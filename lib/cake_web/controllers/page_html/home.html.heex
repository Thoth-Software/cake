<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="hero py-10">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 id="home-title" class="text-5xl font-bold">Cake</h1>
        <p id="home-tagline" class="py-6 text-base-content/70">
          Ask questions of your documents, and get answers that cite their sources.
        </p>
        <.link id="home-log-in" href={~p"/users/log_in"} class="btn btn-primary">Log in</.link>
      </div>
    </div>
  </div>
</Layouts.app>
