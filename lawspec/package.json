{
  "name": "cake-laws",
  "private": true,
  "description": "LawSpec specifications for Cake (see README.md)",
  "scripts": {
    "lawspec": "node --no-turbo-fast-api-calls node_modules/lawspec/bin/lawspec.mjs",
    "check": "node --no-turbo-fast-api-calls node_modules/lawspec/bin/lawspec.mjs check",
    "fmt": "node --no-turbo-fast-api-calls node_modules/lawspec/bin/lawspec.mjs fmt",
    "fmt:check": "node --no-turbo-fast-api-calls node_modules/lawspec/bin/lawspec.mjs fmt --check",
    "generate": "node --no-turbo-fast-api-calls node_modules/lawspec/bin/lawspec.mjs generate",
    "generate:check": "node --no-turbo-fast-api-calls node_modules/lawspec/bin/lawspec.mjs generate --check"
  },
  "devDependencies": {
    "lawspec": "0.32.0"
  }
}
